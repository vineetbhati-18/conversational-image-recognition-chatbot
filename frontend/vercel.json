{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "https://bel-chatbot-api.onrender.com/api/v1/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://bel-chatbot-api.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
