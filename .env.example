# Application Environment Configuration
ENVIRONMENT=development
DEBUG=True

# Backend Service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=bhati
DB_PASSWORD=
DB_NAME=bel_chatbot_db

# AI / ML Device Configuration
# Options: 'mps' (Apple Silicon GPU), 'cuda' (NVIDIA GPU), 'cpu'
TORCH_DEVICE=mps
YOLO_MODEL_NAME=yolov8s.pt
VQA_MODEL_NAME=Salesforce/blip-vqa-base
MAX_IMAGE_SIZE_MB=15

# Security
SECRET_KEY=change-this-in-production-to-a-secure-random-key
