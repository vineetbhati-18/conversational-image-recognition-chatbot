# Backend Production Environment Variables
# In Render, DATABASE_URL is automatically linked from the PostgreSQL database service.
DATABASE_URL=postgresql+asyncpg://bel_admin:password@host:5432/bel_chatbot_db

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false

# CORS Configuration (Comma-separated origins or *)
CORS_ORIGINS=https://*.vercel.app,http://localhost:5173,http://localhost:3000

# Persistent Storage
UPLOAD_DIR=/app/uploads

# Deep Learning Inference Device (cpu in standard cloud containers)
DEVICE_OVERRIDE=cpu
YOLO_MODEL_NAME=yolov8s.pt
VQA_MODEL_NAME=Salesforce/blip-vqa-base
CONFIDENCE_THRESHOLD=0.35
MAX_UPLOAD_SIZE_MB=15
