# Backend Specific Configuration
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Connection (Async PostgreSQL)
DATABASE_URL=postgresql+asyncpg://bhati@localhost:5432/bel_chatbot_db
SYNC_DATABASE_URL=postgresql://bhati@localhost:5432/bel_chatbot_db

# ML Engine & Inference Settings
DEVICE=mps
YOLO_MODEL=yolov8s.pt
VQA_MODEL=Salesforce/blip-vqa-base
CONFIDENCE_THRESHOLD=0.35
MAX_UPLOAD_SIZE_MB=15
UPLOAD_DIR=uploads

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
